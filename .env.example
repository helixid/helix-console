# Local development only (`pnpm dev`). Copy to .env.
# In containers these come from the runtime environment instead — see
# docker/40-env-config.sh and dev spec §6.
#
# Leave VITE_API_BASE_URL empty: helix-api has no CORS handling, so
# requests instead go out as relative /v1 calls that Vite's dev-server
# proxy forwards to helix-api (see vite.config.ts). Only set this to a
# real URL if you've disabled/replaced that proxy.
VITE_API_BASE_URL=
VITE_ADMIN_API_KEY=change-me

# Console login gate (client-side access gate only; defaults to admin/admin).
VITE_CONSOLE_USERNAME=admin
VITE_CONSOLE_PASSWORD=admin
